{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "BUILD_TESTING": true,
        "CMAKE_EXPORT_COMPILE_COMMANDS": true
      }
    },
    {
      "name": "windows-debug",
      "displayName": "Windows MSVC Debug (replay)",
      "inherits": "base",
      "architecture": { "value": "x64", "strategy": "external" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "TICKFORGE_ENABLE_LIVE": false
      },
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "hostOS": ["Windows"],
          "intelliSenseMode": "windows-msvc-x64"
        }
      }
    },
    {
      "name": "linux-debug",
      "displayName": "Linux / WSL GCC Debug (replay)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "g++",
        "TICKFORGE_ENABLE_LIVE": false
      },
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "hostOS": ["Linux"],
          "intelliSenseMode": "linux-gcc-x64"
        }
      }
    },
    {
      "name": "linux-live-debug",
      "displayName": "Linux / WSL GCC Debug (Binance capture)",
      "inherits": "linux-debug",
      "cacheVariables": { "TICKFORGE_ENABLE_LIVE": true }
    }
  ],
  "buildPresets": [
    { "name": "windows-debug", "configurePreset": "windows-debug" },
    { "name": "linux-debug", "configurePreset": "linux-debug", "jobs": 2 },
    { "name": "linux-live-debug", "configurePreset": "linux-live-debug", "jobs": 2 }
  ],
  "testPresets": [
    { "name": "windows-debug", "configurePreset": "windows-debug", "output": { "outputOnFailure": true } },
    { "name": "linux-debug", "configurePreset": "linux-debug", "output": { "outputOnFailure": true } },
    { "name": "linux-live-debug", "configurePreset": "linux-live-debug", "output": { "outputOnFailure": true } }
  ]
}
