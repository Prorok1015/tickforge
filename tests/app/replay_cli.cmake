set(previous "")
foreach(iteration RANGE 1 2)
    execute_process(COMMAND "${PROGRAM}" replay "${FIXTURE}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT "${result}" STREQUAL "0" OR NOT "${error}" STREQUAL "" OR
       NOT output MATCHES "price=65000.00 USDT" OR
       NOT output MATCHES "quantity=0.00100000 BTC" OR
       NOT output MATCHES "3 events: 3 trades, 0 snapshots, 0 depth updates")
        message(FATAL_ERROR "Replay trace mismatch: result=${result}, stderr=${error}, stdout=${output}")
    endif()
    if(iteration EQUAL 2 AND NOT "${output}" STREQUAL "${previous}")
        message(FATAL_ERROR "Replay console output is not deterministic")
    endif()
    set(previous "${output}")
endforeach()
# v4 trades show their ID and aggressor; a jump in IDs is reported as a trade gap.
set(trades "${CMAKE_CURRENT_BINARY_DIR}/replay-trades.csv")
file(WRITE "${trades}" "tickforge,4,BINANCE_SPOT,BTCUSDT,price_scale=100,quantity_scale=100000000\ntrade,1,0,0,0,6500000,100000,5,buy\ntrade,2,0,0,1,6500001,100000,6,sell\ntrade,3,0,0,2,6500002,100000,9,buy\nend,3\n")
execute_process(COMMAND "${PROGRAM}" replay "${trades}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
foreach(expected IN ITEMS "TRADE  | id=5 | BUY aggressor | price=65000.00 USDT" "id=6 | SELL aggressor"
        "STATUS | TRADE GAP | ids 7..8 missing" "Trade feed      | 1 ID gaps or reorders")
    string(FIND "${output}" "${expected}" position)
    if(NOT "${result}" STREQUAL "0" OR position EQUAL -1)
        message(FATAL_ERROR "v4 trade replay missing: ${expected}\n${output}\n${error}")
    endif()
endforeach()
file(REMOVE "${trades}")
execute_process(COMMAND "${PROGRAM}" invalid RESULT_VARIABLE result)
if(NOT "${result}" STREQUAL "2")
    message(FATAL_ERROR "Invalid CLI arguments must return 2")
endif()
execute_process(COMMAND "${PROGRAM}" replay "${FIXTURE}.missing" RESULT_VARIABLE result)
if(NOT "${result}" STREQUAL "1")
    message(FATAL_ERROR "Unreadable session must return 1")
endif()
foreach(duration IN ITEMS 0 -1 3601 1.5 invalid)
    execute_process(COMMAND "${PROGRAM}" capture "${FIXTURE}.unused" "${duration}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT "${result}" STREQUAL "1" OR NOT error MATCHES "capture duration must be an integer")
        message(FATAL_ERROR "Invalid capture duration was not rejected: ${duration}")
    endif()
endforeach()
